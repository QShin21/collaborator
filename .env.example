# Copy to .env and fill in. With no key the app runs on an offline mock model.

# --- Claude (default) ---
ANTHROPIC_API_KEY=
# COLLAB_MODEL=claude-fable-5-2
# COLLAB_EFFORT=medium            # low | medium | high | none
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- or any OpenAI-compatible endpoint ---
# COLLAB_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# COLLAB_MODEL=gpt-4o

# --- server ---
# COLLAB_HOST=127.0.0.1
# COLLAB_PORT=8765
# COLLAB_DB=data/collab.db
# The app only answers requests addressed to 127.0.0.1 / localhost (protection against
# other websites reaching it through your browser). To serve other computers on a LAN:
# COLLAB_HOST=0.0.0.0
# COLLAB_ALLOWED_HOSTS=192.168.1.5,study-pc     # names/addresses people will type
# Model settings can only be changed from the computer running the app.
